<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ShadowsMcp.SaveCli</RootNamespace>
    <AssemblyName>savecli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same JSON layer the mod ships, plus the shared save engine. SaveAnalysis stays
         net472-compatible so the mod can compile it in later for in-game save tools. -->
    <Compile Include="../Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../SaveAnalysis/**/*.cs" LinkBase="SaveAnalysis" />
  </ItemGroup>

</Project>
